# Public (Supabase Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Prefer the new publishable key; anon JWT still works as fallback
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-jwt

# Server-only — invite/link athletes (Dashboard → Settings → API → service_role)
# Never expose to the browser / never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Used in invite redirect links (local or production URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
